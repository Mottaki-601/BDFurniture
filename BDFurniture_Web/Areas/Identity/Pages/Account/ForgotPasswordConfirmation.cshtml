@page

@{
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-page-wrapper auth-page-compact">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="auth-card p-4 p-md-5 text-center">

                    <a class="auth-logo text-decoration-none d-inline-block mb-4"
                       asp-controller="Home"
                       asp-action="Index"
                       style="color:var(--primary)">
                        <i class="fas fa-couch me-2"
                           style="color:var(--gold)"></i>
                        BD <span style="color:var(--gold-dark)">Furniture</span>
                    </a>

                    <div class="auth-status-icon">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>

                    <span class="section-subtitle">
                        ACCOUNT RECOVERY
                    </span>

                    <h1 class="auth-title mb-3">
                        Check Your Email
                    </h1>

                    <p class="text-muted mb-4">
                        If an account matches the email address you
                        entered, a password reset link will be sent.
                        Please check your inbox and spam folder.
                    </p>

                    <div class="auth-message-panel text-start mb-4">
                        <i class="fas fa-info-circle me-2"
                           style="color:var(--gold-dark)"></i>
                        The password reset link may expire for security
                        reasons. Request a new one if necessary.
                    </div>

                    <a asp-page="./ForgotPassword"
                       class="btn-outline-gold w-100 justify-content-center mb-3">
                        <i class="fas fa-redo-alt"></i>
                        Try Again
                    </a>

                    <a asp-page="./Login"
                       class="auth-link fw-semibold">
                        <i class="fas fa-arrow-left me-2"></i>
                        Back to Login
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>
