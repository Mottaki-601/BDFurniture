@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Create New Password";
}

<div class="auth-page-wrapper auth-page-compact">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">

                <div class="auth-card">
                    <div class="row g-0">

                        <!-- Brand Panel -->
                        <div class="col-md-5 auth-brand-side p-4 p-lg-5 d-flex flex-column justify-content-center">

                            <a class="auth-logo text-decoration-none mb-4"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="fas fa-couch me-2"
                                   style="color:var(--gold)"></i>
                                BD <span style="color:var(--gold)">Furniture</span>
                            </a>

                            <div class="auth-mark-icon">
                                <i class="fas fa-lock"></i>
                            </div>

                            <span class="section-subtitle mt-4">
                                SECURE YOUR ACCOUNT
                            </span>

                            <h1 class="auth-brand-heading">
                                Make It Secure. Make It Yours.
                            </h1>

                            <p class="auth-brand-subtext">
                                Choose a new password to protect your
                                BD Furniture account and continue
                                enjoying your shopping experience.
                            </p>

                            <div class="auth-security-note mt-4">
                                <i class="fas fa-shield-alt me-2"></i>
                                Never share your password with anyone.
                            </div>
                        </div>

                        <!-- Reset Form -->
                        <div class="col-md-7 p-4 p-lg-5">

                            <span class="section-subtitle">
                                PASSWORD RESET
                            </span>

                            <h2 class="auth-title">
                                Create New Password
                            </h2>

                            <p class="text-muted mb-4">
                                Enter your account email and choose
                                a strong new password.
                            </p>

                            <form method="post">

                                <div asp-validation-summary="ModelOnly"
                                     class="text-danger small mb-3"
                                     role="alert"></div>

                                <!-- Keep the reset token from the email link -->
                                <input asp-for="Input.Code" type="hidden" />

                                <div class="mb-3">
                                    <label asp-for="Input.Email"
                                           class="form-label fw-semibold">
                                        Email Address
                                    </label>

                                    <div class="auth-input-group">
                                        <i class="fas fa-envelope input-icon"></i>

                                        <input asp-for="Input.Email"
                                               class="form-control auth-input"
                                               autocomplete="username"
                                               aria-required="true"
                                               placeholder="Enter your email" />
                                    </div>

                                    <span asp-validation-for="Input.Email"
                                          class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Password"
                                           class="form-label fw-semibold">
                                        New Password
                                    </label>

                                    <div class="auth-input-group">
                                        <i class="fas fa-lock input-icon"></i>

                                        <input asp-for="Input.Password"
                                               class="form-control auth-input"
                                               autocomplete="new-password"
                                               aria-required="true"
                                               placeholder="Enter new password" />
                                    </div>

                                    <span asp-validation-for="Input.Password"
                                          class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Input.ConfirmPassword"
                                           class="form-label fw-semibold">
                                        Confirm New Password
                                    </label>

                                    <div class="auth-input-group">
                                        <i class="fas fa-check-circle input-icon"></i>

                                        <input asp-for="Input.ConfirmPassword"
                                               class="form-control auth-input"
                                               autocomplete="new-password"
                                               aria-required="true"
                                               placeholder="Re-enter new password" />
                                    </div>

                                    <span asp-validation-for="Input.ConfirmPassword"
                                          class="text-danger small"></span>
                                </div>

                                <button type="submit"
                                        class="btn-gold w-100 justify-content-center">
                                    <i class="fas fa-save"></i>
                                    Reset Password
                                </button>

                            </form>

                            <div class="text-center mt-4">
                                <a asp-page="./Login"
                                   class="auth-link fw-semibold">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    Back to Login
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
