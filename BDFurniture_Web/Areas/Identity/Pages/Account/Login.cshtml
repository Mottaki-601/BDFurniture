@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let isPasswordWrong = false;
        const submitBtn = document.getElementById("login-submit");
        const buttonWrapper = document.getElementById("buttonWrapper");
        let particles = [];

        function shatterButton() {
            if (particles.length > 0) return;

            submitBtn.style.opacity = "0";
            submitBtn.style.pointerEvents = "none";

            const rect = submitBtn.getBoundingClientRect();
            const wrapperRect = buttonWrapper.getBoundingClientRect();

            const leftOffset = rect.left - wrapperRect.left;
            const topOffset = rect.top - wrapperRect.top;

            const rows = 4;
            const cols = 8;
            const pWidth = rect.width / cols;
            const pHeight = rect.height / rows;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const particle = document.createElement("div");
                    particle.classList.add("btn-shatter-particle");

                    particle.style.width = pWidth + "px";
                    particle.style.height = pHeight + "px";
                    particle.style.left = (leftOffset + c * pWidth) + "px";
                    particle.style.top = (topOffset + r * pHeight) + "px";

                    if((r === 0 || r === rows - 1) && (c === 0 || c === cols - 1)) {
                        particle.style.borderRadius = "5px";
                    }

                    const randX = (Math.random() - 0.5) * 160;
                    const randY = (Math.random() - 0.5) * 100 - 30;
                    const randRot = (Math.random() - 0.5) * 360;

                    buttonWrapper.appendChild(particle);
                    particles.push(particle);

                    setTimeout(function() {
                        particle.style.transform = "translate(" + randX + "px, " + randY + "px) rotate(" + randRot + "deg) scale(0.6)";
                        particle.style.opacity = "0.3";
                    }, 20);
                }
            }
        }

        function repairButton() {
            if (particles.length === 0) return;

            particles.forEach(function(p) {
                p.style.transform = "translate(0px, 0px) rotate(0deg) scale(1)";
                p.style.opacity = "1";
            });

            setTimeout(function() {
                particles.forEach(function(p) { p.remove(); });
                particles = [];
                submitBtn.style.opacity = "1";
                submitBtn.style.pointerEvents = "auto";
            }, 500);
        }

        document.getElementById("account").addEventListener("submit", function (e) {
            e.preventDefault();

            if (!jQuery(this).valid()) return;

            const form = jQuery(this);
            const actionUrl = form.attr('action') || window.location.href;
            const formData = form.serialize();

            jQuery.ajax({
                type: "POST",
                url: actionUrl,
                data: formData,
                success: function (response) {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(response, 'text/html');
                    const hasValidationSummaryError = doc.querySelector('.text-danger ul li') !== null || response.includes("Invalid login attempt");

                    if (hasValidationSummaryError) {
                        isPasswordWrong = true;
                        jQuery('#errorMessageContainer').html('⚠ Invalid login attempt. Please check your password!');
                        shatterButton();
                    } else {
                        isPasswordWrong = false;
                        repairButton();
                        jQuery('#errorMessageContainer').html('');

                        document.getElementById("loginFormState").classList.add("d-none");
                        document.getElementById("loginSuccessState").classList.remove("d-none");

                        setTimeout(function () {
                            const urlParams = new URLSearchParams(window.location.search);
                            const returnUrl = urlParams.get('returnUrl') || '/';
                            window.location.href = returnUrl;
                        }, 2000);
                    }
                },
                error: function () {
                    jQuery('#errorMessageContainer').html('⚠ Connection error. Try again.');
                }
            });
        });

        submitBtn.addEventListener("mouseenter", function() {
            if (isPasswordWrong) {
                shatterButton();
            }
        });

        buttonWrapper.addEventListener("mouseleave", function() {
            if (isPasswordWrong) {
                repairButton();
            }
        });

        document.querySelectorAll('.embossed-input').forEach(function(input) {
            input.addEventListener('input', function() {
                if (isPasswordWrong) {
                    isPasswordWrong = false;
                    repairButton();
                    jQuery('#errorMessageContainer').html('');
                }
            });
        });
    </script>
} *@
