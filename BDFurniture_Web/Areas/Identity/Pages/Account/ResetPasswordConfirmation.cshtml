@page

@{
    ViewData["Title"] = "Password Updated";
}

<div class="auth-page-wrapper auth-page-compact">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="auth-card p-4 p-md-5 text-center">

                    <a class="auth-logo text-decoration-none d-inline-block mb-4"
                       asp-controller="Home"
                       asp-action="Index"
                       style="color:var(--primary)">
                        <i class="fas fa-couch me-2"
                           style="color:var(--gold)"></i>
                        BD <span style="color:var(--gold-dark)">Furniture</span>
                    </a>

                    <div class="auth-status-icon auth-status-success">
                        <i class="fas fa-check"></i>
                    </div>

                    <span class="section-subtitle">
                        PASSWORD UPDATED
                    </span>

                    <h1 class="auth-title mb-3">
                        You're All Set!
                    </h1>

                    <p class="text-muted mb-4">
                        Your password has been reset successfully.
                        You can now sign in to your BD Furniture
                        account using your new password.
                    </p>

                    <a asp-page="./Login"
                       class="btn-gold w-100 justify-content-center mb-3">
                        <i class="fas fa-sign-in-alt"></i>
                        Sign In to Your Account
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="auth-link fw-semibold">
                        <i class="fas fa-home me-2"></i>
                        Return to Home
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>
