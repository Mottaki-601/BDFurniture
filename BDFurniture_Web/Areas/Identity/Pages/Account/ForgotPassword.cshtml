@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page-wrapper auth-page-compact">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">

                <div class="auth-card">
                    <div class="row g-0">

                        <!-- Brand Panel -->
                        <div class="col-md-5 auth-brand-side p-4 p-lg-5 d-flex flex-column justify-content-center">

                            <a class="auth-logo text-decoration-none mb-4"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="fas fa-couch me-2"
                                   style="color:var(--gold)"></i>
                                BD <span style="color:var(--gold)">Furniture</span>
                            </a>

                            <div class="auth-mark-icon">
                                <i class="fas fa-key"></i>
                            </div>

                            <span class="section-subtitle mt-4">
                                ACCOUNT RECOVERY
                            </span>

                            <h1 class="auth-brand-heading">
                                A Fresh Start Begins Here
                            </h1>

                            <p class="auth-brand-subtext">
                                Forgot your password? No worries.
                                We'll help you regain access to your
                                BD Furniture account securely.
                            </p>

                            <div class="auth-security-note mt-4">
                                <i class="fas fa-shield-alt me-2"></i>
                                Your account security matters to us.
                            </div>
                        </div>

                        <!-- Form Panel -->
                        <div class="col-md-7 p-4 p-lg-5">

                            <span class="section-subtitle">
                                WELCOME BACK
                            </span>

                            <h2 class="auth-title">
                                Forgot Password?
                            </h2>

                            <p class="text-muted mb-4">
                                Enter the email address associated with
                                your account. If an account matches,
                                we'll send you a secure reset link.
                            </p>

                            <form method="post">

                                <div asp-validation-summary="ModelOnly"
                                     class="text-danger small mb-3"
                                     role="alert"></div>

                                <div class="mb-4">
                                    <label asp-for="Input.Email"
                                           class="form-label fw-semibold">
                                        Email Address
                                    </label>

                                    <div class="auth-input-group">
                                        <i class="fas fa-envelope input-icon"></i>

                                        <input asp-for="Input.Email"
                                               class="form-control auth-input"
                                               autocomplete="username"
                                               aria-required="true"
                                               placeholder="Enter your email address" />
                                    </div>

                                    <span asp-validation-for="Input.Email"
                                          class="text-danger small"></span>
                                </div>

                                <button type="submit"
                                        class="btn-gold w-100 justify-content-center">
                                    <i class="fas fa-paper-plane"></i>
                                    Send Reset Link
                                </button>

                            </form>

                            <div class="text-center mt-4">
                                <a class="auth-link fw-semibold"
                                   asp-page="./Login">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    Back to Login
                                </a>
                            </div>

                            <div class="text-center mt-4 small text-muted">
                                Need help?
                                <a asp-controller="Home"
                                   asp-action="Contact"
                                   class="auth-link">
                                    Contact BD Furniture
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
