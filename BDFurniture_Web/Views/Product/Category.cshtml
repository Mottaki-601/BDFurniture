@{
    ViewData["Title"] = (ViewBag.Category as BDFurniture_Web.Models.Category)?.Name + " - BD Furniture";
    var category = ViewBag.Category as BDFurniture_Web.Models.Category;
    var products = ViewBag.Products as List<BDFurniture_Web.Models.Product> ?? new();
    var allCategories = ViewBag.AllCategories as List<BDFurniture_Web.Models.Category> ?? new();
}

<!-- Page Hero -->
<div class="page-hero" style="padding-top:6rem;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-bd">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">@category?.Name</li>
            </ol>
        </nav>
        <h1 style="margin-top:0.5rem;"><i class="@(category?.IconClass ?? "fas fa-cube") me-2" style="color:var(--gold);"></i> @category?.Name</h1>
        <p style="color:rgba(255,255,255,0.75);margin-top:0.5rem;">@category?.Description</p>
    </div>
</div>

<section class="section-pad">
    <div class="container">
        <!-- Category Filter Chips -->
        <div class="filter-bar">
            <span style="font-weight:700;color:var(--primary);font-size:0.875rem;">Browse:</span>
            @foreach (var cat in allCategories)
            {
                <a href="/collection/@cat.Slug" class="filter-chip @(cat.Id == category?.Id ? "active" : "")">@cat.Name</a>
            }
        </div>

        <!-- SubCategory Chips -->
        @if (category?.SubCategories?.Any() == true)
        {
            <div class="filter-bar" style="background:var(--cream);margin-bottom:2rem;">
                <span style="font-weight:700;color:var(--text-medium);font-size:0.8rem;">Filter by:</span>
                <a href="/collection/@category.Slug" class="filter-chip active">All @category.Name</a>
                @foreach (var sub in category.SubCategories.Where(s => s.IsActive).OrderBy(s => s.SortOrder))
                {
                    <a href="/collection/@category.Slug/@sub.Slug" class="filter-chip">@sub.Name</a>
                }
            </div>
        }

        @if (products.Any())
        {
            <div class="row g-3 g-md-4">
                @foreach (var product in products)
                {
                    var mainImg = product.Images?.FirstOrDefault(i => i.IsMain) ?? product.Images?.FirstOrDefault();
                    var waMsg = Uri.EscapeDataString($"Hello! I'm interested in: {product.Name}");
                    <div class="col-6 col-md-4 col-lg-3 aos-fade-up">
                        <div class="product-card">
                            <div class="product-card-img">
                                @if (product.IsFeatured) { <span class="product-badge">Featured</span> }
                                @if (mainImg != null)
                                {
                                    <img src="@mainImg.ImagePath" alt="@product.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--cream-dark);"><i class="fas fa-couch" style="font-size:3rem;color:var(--gold-light);"></i></div>
                                }
                            </div>
                            <div class="product-card-body">
                                <div class="product-card-category">@product.SubCategory?.Name</div>
                                <div class="product-card-name">@product.Name</div>
                                <div class="star-rating">
                                    @for (int i = 1; i <= 5; i++) { <i class="fas fa-star @(i <= (int)product.AverageRating ? "filled" : "")"></i> }
                                    <span class="rating-count">(@product.TotalRatings)</span>
                                </div>
                                @if (product.Price.HasValue)
                                {
                                    <div class="product-card-price">
                                        ৳@(product.DiscountPrice?.ToString("N0") ?? product.Price.Value.ToString("N0"))
                                        @if (product.DiscountPrice.HasValue) { <span class="original-price">৳@product.Price.Value.ToString("N0")</span> }
                                    </div>
                                }
                                <div class="product-card-actions">
                                    <a href="/product/@product.Slug" class="btn-view-detail"><i class="fas fa-eye"></i> View Details</a>
                                    <a href="https://wa.me/@(product.WhatsAppNumber?.Replace("+",""))/?text=@waMsg" target="_blank" class="btn-whatsapp"><i class="fab fa-whatsapp"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center" style="padding:5rem 0;">
                <i class="fas fa-box-open" style="font-size:4rem;color:var(--gold-light);"></i>
                <h3 style="margin-top:1.5rem;color:var(--text-medium);">No products yet</h3>
                <p style="color:var(--text-light);">Products for this category will appear here soon.</p>
                <a href="/" class="btn-gold mt-3"><i class="fas fa-home"></i> Back to Home</a>
            </div>
        }
    </div>
</section>
