@using BDFurniture_Web.Data
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Assign Roles";

    var users = ViewBag.users as List<ApplicationUser>
                ?? new List<ApplicationUser>();

    var roles = ViewBag.roles as List<IdentityRole>
                ?? new List<IdentityRole>();

    var userRoleMap =
        ViewBag.userRoleMap as Dictionary<string, IList<string>>
        ?? new Dictionary<string, IList<string>>();

    var msg = ViewBag.msg as string;
    var error = ViewBag.error as string;
}

<!-- ASSIGN ROLES HERO: styled like the Admin Dashboard header -->
<section class="role-dashboard-hero" style="margin-top:-50px !important; position:relative; z-index:50; padding-top:9rem;">
    <div class="container">
        <div class="role-dashboard-hero-inner">
            <div class="role-dashboard-hero-heading">
                <i class="fas fa-user-tag role-dashboard-hero-icon" aria-hidden="true"></i>
                <div>
                    <h1>Assign Roles</h1>
                    <p>Manage roles assigned to registered users.</p>
                </div>
            </div>

            <a asp-controller="Role"
               asp-action="Index"
               class="role-dashboard-hero-button">
                <i class="fas fa-arrow-left"></i>
                Role Management
            </a>
        </div>
    </div>
</section>

<div class="container py-4">

    @if (!string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @msg
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Assign Role Form -->
        <div class="col-12 col-lg-5">
            <div class="admin-card h-100">
                <h4 class="mb-1">
                    <i class="fas fa-user-tag me-2"
                       style="color:var(--gold);"></i>
                    Assign Role to User
                </h4>

                <p class="text-muted small mb-4">
                    Choose an existing user and role.
                </p>

                <form asp-controller="Role"
                      asp-action="AssignRole"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="userData" class="form-label fw-semibold">
                            User
                        </label>

                        <select id="userData"
                                name="userData"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select User --
                            </option>

                            @foreach (var user in users)
                            {
                                <option value="@user.Email">
                                    @user.Email
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="roleData" class="form-label fw-semibold">
                            Role
                        </label>

                        <select id="roleData"
                                name="roleData"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Role --
                            </option>

                            @foreach (var role in roles)
                            {
                                <option value="@role.Name">
                                    @role.Name
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">
                        <i class="fas fa-user-plus me-2"></i>
                        Assign Role
                    </button>
                </form>
            </div>
        </div>

        <!-- Existing User Role Assignments -->
        <div class="col-12 col-lg-7">
            <div class="admin-card">
                <h4 class="mb-1">
                    <i class="fas fa-users-cog me-2"
                       style="color:var(--gold);"></i>
                    Current Assignments
                </h4>

                <p class="text-muted small mb-4">
                    Remove a custom role from a user when necessary.
                </p>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var hasAssignments = false;
                            }

                            @foreach (var user in users)
                            {
                                IList<string> assignedRoles;

                                if (!userRoleMap.TryGetValue(
                                user.Id, out assignedRoles!))
                                {
                                    assignedRoles = new List<string>();
                                }

                                @foreach (var roleName in assignedRoles)
                                {
                                    hasAssignments = true;

                                    var isSystemRole =
                                    string.Equals(
                                    roleName, "Admin",
                                    StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(
                                    roleName, "Customer",
                                    StringComparison.OrdinalIgnoreCase);

                                    <tr>
                                        <td class="small">
                                            @user.Email
                                        </td>

                                        <td>
                                            <span class="badge"
                                                  style="background:var(--cream-dark);
                                                                         color:var(--primary);">
                                                @roleName
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            @if (!isSystemRole)
                                            {
                                                <form asp-controller="Role"
                                                      asp-action="RemoveRoleFromUser"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Remove this role assignment?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.Id" />

                                                    <input type="hidden"
                                                           name="roleName"
                                                           value="@roleName" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Remove role">
                                                        <i class="fas fa-user-minus"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <i class="fas fa-lock text-muted"
                                                   title="Protected system role"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            }

                            @if (!hasAssignments)
                            {
                                <tr>
                                    <td colspan="3"
                                        class="text-center text-muted py-4">
                                        No role assignments found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="small text-muted mb-0">
                    <i class="fas fa-shield-alt me-1"></i>
                    Admin and Customer assignmenthis page.
                </p>
            </dits are protected on v>
        </div>
    </div>
</div>