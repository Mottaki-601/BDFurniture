@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Role Management";

    var roles = ViewBag.roles as List<IdentityRole>
                ?? new List<IdentityRole>();

    var roleUserCounts =
        ViewBag.roleUserCounts as Dictionary<string, int>
        ?? new Dictionary<string, int>();

    var msg = ViewBag.msg as string;
    var error = ViewBag.error as string;
}

<!-- ROLE MANAGEMENT HERO: styled like the Admin Dashboard header -->
<section class="role-dashboard-hero" style="margin-top:-50px !important; position:relative; z-index:50; padding-top:9rem;">
    <div class="container">
        <div class="role-dashboard-hero-inner">
            <div class="role-dashboard-hero-heading">
                <i class="fas fa-users-cog role-dashboard-hero-icon" aria-hidden="true"></i>
                <div>
                    <h1>Role Management</h1>
                    <p>Create and manage user roles.</p>
                </div>
            </div>

            <a asp-controller="Role"
               asp-action="AssignRole"
               class="role-dashboard-hero-button">
                <i class="fas fa-user-tag"></i>
                Assign Roles
            </a>
        </div>
    </div>
</section>

<div class="container py-4">

    @if (!string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @msg
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Create Role -->
        <div class="col-12 col-lg-4">
            <div class="admin-card h-100">
                <h4 class="mb-1">
                    <i class="fas fa-plus-circle me-2"
                       style="color:var(--gold);"></i>
                    Create New Role
                </h4>

                <p class="text-muted small mb-4">
                    Add a custom role to your application.
                </p>

                <form asp-controller="Role"
                      asp-action="CreateRole"
                      method="post">

                    @Html.AntiForgeryToken()

                    <label for="userRole" class="form-label fw-semibold">
                        Role Name
                    </label>

                    <input type="text"
                           id="userRole"
                           name="userRole"
                           class="form-control mb-3"
                           placeholder="e.g. ContentManager"
                           minlength="2"
                           maxlength="50"
                           required />

                    <button type="submit" class="btn btn-dark w-100">
                        <i class="fas fa-plus me-2"></i>
                        Create Role
                    </button>
                </form>

                <hr />

                <p class="small text-muted mb-0">
                    <i class="fas fa-lock me-1"></i>
                    Admin and Customer are protected system roles.
                </p>
            </div>
        </div>

        <!-- Existing Roles -->
        <div class="col-12 col-lg-8">
            <div class="admin-card">
                <div class="d-flex justify-content-between
                            align-items-center mb-3">
                    <h4 class="mb-0">
                        <i class="fas fa-users-cog me-2"
                           style="color:var(--gold);"></i>
                        Existing Roles
                    </h4>

                    <span class="badge text-bg-secondary">
                        @roles.Count roles
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Users</th>
                                <th>Type</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (!roles.Any())
                            {
                                <tr>
                                    <td colspan="4"
                                        class="text-center text-muted py-4">
                                        No roles found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var role in roles)
                                {
                                    var isSystemRole =
                                    string.Equals(
                                    role.Name, "Admin",
                                    StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(
                                    role.Name, "Customer",
                                    StringComparison.OrdinalIgnoreCase);

                                    var assignedCount =
                                    roleUserCounts.TryGetValue(
                                    role.Id, out var count)
                                    ? count : 0;

                                    <tr>
                                        <td class="fw-semibold">
                                            @role.Name
                                        </td>

                                        <td>
                                            <span class="badge rounded-pill"
                                                  style="background:var(--cream-dark);
                                                                 color:var(--primary);">
                                                @assignedCount
                                            </span>
                                        </td>

                                        <td>
                                            @if (isSystemRole)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-lock me-1"></i>
                                                    System
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge"
                                                      style="background:var(--gold-light);
                                                                         color:var(--primary);">
                                                    Custom
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            @if (!isSystemRole)
                                            {
                                                <a asp-controller="Role"
                                                   asp-action="EditRole"
                                                   asp-route-id="@role.Id"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Edit role">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                @if (assignedCount == 0)
                                                {
                                                    <form asp-controller="Role"
                                                          asp-action="DeleteRole"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('Delete this role?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@role.Id" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Delete role">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            disabled
                                                            title="Remove user assignments first">
                                                        <i class="fas fa-lock"></i>
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <i class="fas fa-shield-alt text-muted"
                                                   title="Protected role"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <p class="small text-muted mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    A role can only be deleted when it has no assigned users.
                </p>
            </div>
        </div>
    </div>
</div>