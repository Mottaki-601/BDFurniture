
@{
    ViewData["Title"] = "Index";
}

<h1 class="display-5 alert-info">Role Manager</h1>
<div class="row">
    <h4 class="text-primary text-center">@ViewBag.msg</h4>
</div>
<div class="row">
    <div class="col">
        <form asp-action="CreateRole" asp-controller="Role" method="post">
           <div class="row mb-2">
               <label class="col-form-label col-2"></label>
               <div class="col-6">
                   <input type="text" name="userRole" class="form-control form-control-sm" placeholder="Please type role name..."/>
               </div>
               <div class="col-4">
                  <button type="submit" class="btn btn-primary btn-sm">Create Role</button>
               </div>
           </div>
        </form>
    </div>
</div>

