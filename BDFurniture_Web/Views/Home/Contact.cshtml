@{
    ViewData["Title"] = "Contact Us - BD Furniture";
}

<div class="page-hero" style="padding-top:6rem;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-bd">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Contact Us</li>
            </ol>
        </nav>
        <h1 style="margin-top:0.5rem;"><i class="fas fa-headset me-2" style="color:var(--gold);"></i> Contact Us</h1>
        <p style="color:rgba(255,255,255,0.75);">Have a question or custom design requirement? We are here to help!</p>
    </div>
</div>

<section class="section-pad about-contact-section">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-start">
            <!-- Details -->
            <div class="col-12 col-lg-5">
                <span class="section-subtitle">✦ Get in touch</span>
                <h2>Let's Talk About Your<br /><span style="color:var(--gold);">Furniture Needs</span></h2>
                <div class="section-divider" style="margin:1rem 0;"></div>
                <p style="color:var(--text-medium);line-height:1.8;margin-bottom:2rem;">
                    Feel free to reach out to us directly through phone, WhatsApp, or drop a message using the form.
                </p>

                <div class="about-info-item">
                    <div class="about-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div>
                        <h6>Office &amp; Showroom</h6>
                        <p>Dhaka, Bangladesh</p>
                    </div>
                </div>
                <div class="about-info-item">
                    <div class="about-icon"><i class="fas fa-phone"></i></div>
                    <div>
                        <h6>Customer Support</h6>
                        <p><a href="tel:+8801XXXXXXXXX" style="color:inherit;text-decoration:none;">+880 1XXX-XXXXXX</a></p>
                    </div>
                </div>
                <div class="about-info-item">
                    <div class="about-icon"><i class="fas fa-envelope"></i></div>
                    <div>
                        <h6>Official Email</h6>
                        <p><a href="mailto:info@bdfurniture.com" style="color:inherit;text-decoration:none;">info@bdfurniture.com</a></p>
                    </div>
                </div>
                <div class="about-info-item">
                    <div class="about-icon"><i class="fab fa-whatsapp"></i></div>
                    <div>
                        <h6>Direct WhatsApp Order &amp; Inquiry</h6>
                        <p><a href="https://wa.me/8801XXXXXXXXX" target="_blank" style="color:#25D366;text-decoration:none;font-weight:600;">Chat on WhatsApp <i class="fas fa-external-link-alt" style="font-size:0.75rem;"></i></a></p>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <div class="col-12 col-lg-7">
                <div class="contact-form-card">
                    <h3 style="margin-bottom:0.25rem;">Send Us a Message</h3>
                    <p style="color:var(--text-medium);font-size:0.875rem;margin-bottom:1.75rem;">Fill out the form below and our team will get in touch with you promptly.</p>

                    <form id="contactForm">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Your Name *</label>
                                <input type="text" name="Name" class="form-control-bd" placeholder="Enter your name" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Email Address *</label>
                                <input type="email" name="Email" class="form-control-bd" placeholder="Enter your email" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Phone Number</label>
                                <input type="tel" name="PhoneNumber" class="form-control-bd" placeholder="+880 1XXX-XXXXXX" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Subject</label>
                                <input type="text" name="Subject" class="form-control-bd" placeholder="What is this inquiry regarding?" />
                            </div>
                            <div class="col-12">
                                <label class="form-label-bd">Message *</label>
                                <textarea name="Message" class="form-control-bd" rows="5" placeholder="Write your requirements or questions here..." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-gold w-100" style="justify-content:center;">
                                    <i class="fas fa-paper-plane"></i> Send Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

