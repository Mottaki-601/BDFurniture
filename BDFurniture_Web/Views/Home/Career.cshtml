@{
    ViewData["Title"] = "Career - BD Furniture";
}

<div class="page-hero" style="padding-top:6rem;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-bd">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Career</li>
            </ol>
        </nav>
        <h1 style="margin-top:0.5rem;"><i class="fas fa-briefcase me-2" style="color:var(--gold);"></i> Career at BD Furniture</h1>
        <p style="color:rgba(255,255,255,0.75);">Join our team of passionate craftsmen, designers, and innovators.</p>
    </div>
</div>

<section class="section-pad">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="contact-form-card mb-4">
                    <h3>Why Work With Us?</h3>
                    <div class="section-divider" style="margin:1rem 0;"></div>
                    <p style="color:var(--text-medium);line-height:1.8;">
                        At BD Furniture, we believe in nurturing talent and rewarding creativity. We offer an inclusive working environment, competitive compensation, and ample opportunities for career development across design, carpentry, sales, and marketing.
                    </p>
                </div>

                <div class="contact-form-card">
                    <h3>Drop Your CV / Inquire</h3>
                    <p style="color:var(--text-medium);font-size:0.875rem;margin-bottom:1.5rem;">Interested in joining our team? Send us your details below.</p>
                    <form id="contactForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Subject" value="Career Inquiry" />
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Full Name *</label>
                                <input type="text" name="Name" class="form-control-bd" placeholder="Your name" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Email Address *</label>
                                <input type="email" name="Email" class="form-control-bd" placeholder="Your email" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Phone Number *</label>
                                <input type="tel" name="PhoneNumber" class="form-control-bd" placeholder="+880 1XXX-XXXXXX" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label-bd">Position of Interest</label>
                                <input type="text" name="Subject" class="form-control-bd" placeholder="e.g. Interior Designer, Sales Officer" />
                            </div>
                            <div class="col-12">
                                <label class="form-label-bd">Cover Letter / Experience Summary *</label>
                                <textarea name="Message" class="form-control-bd" rows="4" placeholder="Briefly describe your experience and skills..." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-gold w-100" style="justify-content:center;">
                                    <i class="fas fa-paper-plane"></i> Submit Application
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

