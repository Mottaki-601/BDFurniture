<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BD Furniture - Premium Quality Furniture for Your Home" />
    <title>@ViewData["Title"] - BD Furniture</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<nav class="navbar-main navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="fas fa-couch me-2" style="color: var(--gold);"></i>BD <span>Furniture</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-1">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item nav-mega-dropdown">
                    <a class="nav-link" href="#">Bedroom <i class="fas fa-chevron-down ms-1" style="font-size:0.65rem;"></i></a>
                    <div class="mega-menu">
                        <div class="container"><div class="row"><div class="col-12 col-lg-3">
                            <div class="mega-menu-title">Bedroom Collection</div>
                            <a class="mega-menu-link" href="/collection/bedroom/almirah"><i class="fas fa-door-closed"></i> Almirah</a>
                            <a class="mega-menu-link" href="/collection/bedroom/bed"><i class="fas fa-bed"></i> Bed</a>
                            <a class="mega-menu-link" href="/collection/bedroom/bedroom-set"><i class="fas fa-layer-group"></i> Bedroom Set</a>
                            <a class="mega-menu-link" href="/collection/bedroom/bedside-table"><i class="fas fa-table"></i> Bedside Table</a>
                            <a class="mega-menu-link" href="/collection/bedroom/dressing-table"><i class="fas fa-mirror"></i> Dressing Table</a>
                            <a class="mega-menu-link" href="/collection/bedroom/king-chair"><i class="fas fa-chair"></i> King Chair</a>
                            <a class="mega-menu-link" asp-controller="Product" asp-action="Category" asp-route-slug="bedroom"><i class="fas fa-arrow-right"></i> <strong>View All Bedroom</strong></a>
                        </div></div></div>
                    </div>
                </li>
                <li class="nav-item nav-mega-dropdown">
                    <a class="nav-link" href="#">Living Room <i class="fas fa-chevron-down ms-1" style="font-size:0.65rem;"></i></a>
                    <div class="mega-menu">
                        <div class="container"><div class="row"><div class="col-12 col-lg-3">
                            <div class="mega-menu-title">Living Room Collection</div>
                            <a class="mega-menu-link" href="/collection/living-room/2-2-1-sofa"><i class="fas fa-couch"></i> 2+2+1 Sofa</a>
                            <a class="mega-menu-link" href="/collection/living-room/center-table"><i class="fas fa-table"></i> Center Table</a>
                            <a class="mega-menu-link" href="/collection/living-room/corner-sofa"><i class="fas fa-couch"></i> Corner Sofa</a>
                            <a class="mega-menu-link" href="/collection/living-room/single-sofa"><i class="fas fa-chair"></i> Single Sofa</a>
                            <a class="mega-menu-link" href="/collection/living-room/sofa-set"><i class="fas fa-layer-group"></i> Sofa Set</a>
                            <a class="mega-menu-link" asp-controller="Product" asp-action="Category" asp-route-slug="living-room"><i class="fas fa-arrow-right"></i> <strong>View All Living Room</strong></a>
                        </div></div></div>
                    </div>
                </li>
                <li class="nav-item nav-mega-dropdown">
                    <a class="nav-link" href="#">Dining Room <i class="fas fa-chevron-down ms-1" style="font-size:0.65rem;"></i></a>
                    <div class="mega-menu">
                        <div class="container"><div class="row"><div class="col-12 col-lg-3">
                            <div class="mega-menu-title">Dining Room Collection</div>
                            <a class="mega-menu-link" href="/collection/dining-room/dining-chair"><i class="fas fa-chair"></i> Dining Chair</a>
                            <a class="mega-menu-link" href="/collection/dining-room/dining-set"><i class="fas fa-layer-group"></i> Dining Set</a>
                            <a class="mega-menu-link" href="/collection/dining-room/dining-wagon"><i class="fas fa-cart-flatbed"></i> Dining Wagon</a>
                            <a class="mega-menu-link" href="/collection/dining-room/showcase"><i class="fas fa-cabinet-filing"></i> Showcase</a>
                            <a class="mega-menu-link" href="/collection/dining-room/dining-table"><i class="fas fa-table"></i> Dining Table</a>
                            <a class="mega-menu-link" asp-controller="Product" asp-action="Category" asp-route-slug="dining-room"><i class="fas fa-arrow-right"></i> <strong>View All Dining</strong></a>
                        </div></div></div>
                    </div>
                </li>
                <li class="nav-item nav-mega-dropdown">
                    <a class="nav-link" href="#">Others <i class="fas fa-chevron-down ms-1" style="font-size:0.65rem;"></i></a>
                    <div class="mega-menu">
                        <div class="container"><div class="row">
                            <div class="col-6 col-lg-3">
                                <div class="mega-menu-title">Home Decor</div>
                                <a class="mega-menu-link" href="/collection/home-decor/wall-art"><i class="fas fa-image"></i> Wall Art</a>
                                <a class="mega-menu-link" href="/collection/home-decor/curtains"><i class="fas fa-scroll"></i> Curtains</a>
                                <a class="mega-menu-link" href="/collection/home-decor/cushions"><i class="fas fa-cloud"></i> Cushions</a>
                                <a class="mega-menu-link" href="/collection/home-decor/vase"><i class="fas fa-vial"></i> Vase</a>
                                <a class="mega-menu-link" href="/collection/home-decor/mirror"><i class="fas fa-circle"></i> Mirror</a>
                                <a class="mega-menu-link" asp-controller="Product" asp-action="Category" asp-route-slug="home-decor"><i class="fas fa-arrow-right"></i> <strong>All Home Decor</strong></a>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="mega-menu-title">Interior Design</div>
                                <a class="mega-menu-link" href="/collection/interior-design/full-interior"><i class="fas fa-home"></i> Full Interior</a>
                                <a class="mega-menu-link" href="/collection/interior-design/modular-kitchen"><i class="fas fa-utensils"></i> Modular Kitchen</a>
                                <a class="mega-menu-link" href="/collection/interior-design/office-interior"><i class="fas fa-building"></i> Office Interior</a>
                                <a class="mega-menu-link" asp-controller="Product" asp-action="Category" asp-route-slug="interior-design"><i class="fas fa-arrow-right"></i> <strong>All Interior</strong></a>
                            </div>
                        </div></div>
                    </div>
                </li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Career">Career</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" style="color: var(--gold) !important;" asp-controller="Admin" asp-action="Index"><i class="fas fa-cog"></i> Admin</a></li>
                }
            </ul>
            <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                <partial name="_LoginPartial" />
                <a href="tel:+8801XXXXXXXXX" class="nav-link btn-call d-none d-lg-flex"><i class="fas fa-phone me-1"></i> Call Now</a>
            </div>
        </div>
    </div>
</nav>

<main>@RenderBody()</main>

<footer class="footer-main">
    <div class="container">
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="footer-brand"><i class="fas fa-couch me-2" style="color: var(--gold);"></i>BD <span>Furniture</span></div>
                <p class="footer-desc">Premium quality furniture crafted with passion. Transform your home into a comfortable and elegant masterpiece.</p>
                <div class="footer-social">
                    <a href="#" class="social-btn fb" target="_blank"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-btn yt" target="_blank"><i class="fab fa-youtube"></i></a>
                    <a href="https://wa.me/8801XXXXXXXXX" class="social-btn wa" target="_blank"><i class="fab fa-whatsapp"></i></a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-title">Quick Links</div>
                <ul class="footer-links">
                    <li><a href="/"><i class="fas fa-chevron-right"></i> Home</a></li>
                    <li><a href="/collection/bedroom"><i class="fas fa-chevron-right"></i> Bedroom</a></li>
                    <li><a href="/collection/living-room"><i class="fas fa-chevron-right"></i> Living Room</a></li>
                    <li><a href="/collection/dining-room"><i class="fas fa-chevron-right"></i> Dining Room</a></li>
                    <li><a href="/Home/Career"><i class="fas fa-chevron-right"></i> Career</a></li>
                    <li><a href="/Home/Contact"><i class="fas fa-chevron-right"></i> Contact</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-title">Collections</div>
                <ul class="footer-links">
                    <li><a href="/collection/home-decor"><i class="fas fa-chevron-right"></i> Home Decor</a></li>
                    <li><a href="/collection/interior-design"><i class="fas fa-chevron-right"></i> Interior</a></li>
                    <li><a href="/collection/others"><i class="fas fa-chevron-right"></i> Others</a></li>
                </ul>
            </div>
            <div class="col-12 col-lg-4">
                <div class="footer-title">Stay Connected</div>
                <div style="margin-bottom:1rem;">
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;"><i class="fas fa-map-marker-alt" style="color:var(--gold);width:16px;"></i><span style="font-size:0.875rem;">Dhaka, Bangladesh</span></div>
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;"><i class="fas fa-phone" style="color:var(--gold);width:16px;"></i><a href="tel:+8801XXXXXXXXX" style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.875rem;">+880 1XXX-XXXXXX</a></div>
                    <div style="display:flex;align-items:center;gap:0.5rem;"><i class="fas fa-envelope" style="color:var(--gold);width:16px;"></i><a href="mailto:info@bdfurniture.com" style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.875rem;">info@bdfurniture.com</a></div>
                </div>
                <p style="font-size:0.8rem;color:rgba(255,255,255,0.5);margin-bottom:0.5rem;">Subscribe to get our latest updates</p>
                <form id="newsletterForm">
                    @Html.AntiForgeryToken()
                    <div class="newsletter-form">
                        <input type="email" name="email" class="newsletter-input" placeholder="Your email address" required />
                        <button type="submit" class="btn-newsletter">Subscribe</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="footer-bottom"><div class="container"><p class="mb-0">&copy; @DateTime.Now.Year BD Furniture. All rights reserved. Crafted with <i class="fas fa-heart" style="color:#e74c3c;"></i> in Bangladesh</p></div></div>
</footer>

<a href="https://wa.me/8801XXXXXXXXX" class="whatsapp-float" target="_blank"><i class="fab fa-whatsapp"></i></a>
<button class="scroll-top-btn"><i class="fas fa-chevron-up"></i></button>

<div class="modal fade modal-bd" id="ytModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="fab fa-youtube me-2"></i>BD Furniture</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body p-0">
                <div style="position:relative;padding-bottom:56.25%;height:0;"><iframe id="ytIframe" src="" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

