@model BDFurniture_Web.Models.Product
@{
    ViewData["Title"] = "Add New Product - BD Furniture Admin";
    var categories = ViewBag.Categories as List<BDFurniture_Web.Models.Category> ?? new();
    var subCategories = ViewBag.SubCategories as List<BDFurniture_Web.Models.SubCategory> ?? new();
}

<div class="page-hero" style="padding-top:6rem;padding-bottom:2rem;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-bd">
                <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Products">Products</a></li>
                <li class="breadcrumb-item active">Add Product</li>
            </ol>
        </nav>
        <h1><i class="fas fa-plus-circle me-2" style="color:var(--gold);"></i> Add New Product</h1>
    </div>
</div>

<section class="section-pad">
    <div class="container">
        <div class="admin-card">
            <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-4">
                    <!-- Basic Information -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label-bd">Product Name *</label>
                        <input asp-for="Name" class="form-control-bd" placeholder="e.g. Royal King Size Bed" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label-bd">Select Subcategory *</label>
                        <select asp-for="SubCategoryId" class="form-control-bd" required id="subCategorySelect">
                            <option value="">-- Choose Subcategory --</option>
                            @foreach (var cat in categories)
                            {
                                <optgroup label="@cat.Name">
                                    @foreach (var sub in cat.SubCategories)
                                    {
                                        <option value="@sub.Id">@sub.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <span asp-validation-for="SubCategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Pricing & WhatsApp -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Price" class="form-label-bd">Regular Price (৳)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control-bd" placeholder="e.g. 45000" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="DiscountPrice" class="form-label-bd">Discount Price (৳)</label>
                        <input asp-for="DiscountPrice" type="number" step="0.01" class="form-control-bd" placeholder="e.g. 39999" />
                        <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="WhatsAppNumber" class="form-label-bd">WhatsApp Order Phone *</label>
                        <input asp-for="WhatsAppNumber" class="form-control-bd" value="+8801700000000" required />
                        <span asp-validation-for="WhatsAppNumber" class="text-danger small"></span>
                    </div>

                    <!-- Short Description -->
                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label-bd">Short Summary</label>
                        <input asp-for="ShortDescription" class="form-control-bd" placeholder="Brief 1-2 sentence overview of the product" />
                    </div>

                    <!-- Detailed Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label-bd">Full Details / Dimensions / Wood Quality</label>
                        <textarea asp-for="Description" class="form-control-bd" rows="5" placeholder="Include materials (e.g. Segun wood, Chittagong Teak), dimensions, warranty, polish finish..."></textarea>
                    </div>

                    <!-- Photos -->
                    <div class="col-12">
                        <label class="form-label-bd">Upload Product Images (Select multiple)</label>
                        <input type="file" name="images" id="productImagesInput" multiple class="form-control-bd" accept="image/*" />
                        <small class="text-muted d-block mt-1">
                            ছবিগুলো সিলেক্ট করার পর নিচে প্রিভিউ দেখা যাবে। সেখান থেকে যেকোনো একটি ছবিকে <strong>Background Image</strong> হিসেবে নির্ধারণ করতে পারবেন (অথবা কোনটিই না)।
                        </small>

                        <!-- Dynamic Image Preview & Radio Options -->
                        <div id="imagePreviewContainer" class="row g-3 mt-2 d-none"></div>
                    </div>

                    <!-- Featured and Active Flags -->
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="isFeaturedCheck" />
                            <label class="form-check-label fw-bold" for="isFeaturedCheck">Showcase on Home Page (Featured)</label>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" checked id="isActiveCheck" />
                            <label class="form-check-label fw-bold" for="isActiveCheck">Active in Store</label>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn-gold"><i class="fas fa-save me-1"></i> Save Product</button>
                        <a asp-action="Products" class="btn btn-outline-secondary" style="border-radius:50px;padding:0.75rem 2rem;">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imgInput = document.getElementById('productImagesInput');
        const previewContainer = document.getElementById('imagePreviewContainer');

        if (imgInput && previewContainer) {
            imgInput.addEventListener('change', function () {
                previewContainer.innerHTML = '';
                if (!this.files || this.files.length === 0) {
                    previewContainer.classList.add('d-none');
                    return;
                }

                previewContainer.classList.remove('d-none');

                // Option: No Background Image (All normal images)
                const noneCard = document.createElement('div');
                noneCard.className = 'col-12';
                noneCard.innerHTML = `
                    <div class="p-2 border rounded-3 bg-light d-flex align-items-center gap-2">
                        <input class="form-check-input bg-radio" type="radio" name="bgImageIndex" id="bg_none" value="-1" checked>
                        <label class="form-check-label fw-bold text-muted small mb-0" for="bg_none" style="cursor:pointer;">
                            <i class="fas fa-layer-group me-1 text-gold"></i> কোনো ব্যাকগ্রাউন্ড ইমেজ নয় (সবগুলো সাধারণ স্ক্রলেবল ইমেজ হিসেবে থাকবে)
                        </label>
                    </div>
                `;
                previewContainer.appendChild(noneCard);

                // Add card for each selected file
                Array.from(this.files).forEach((file, index) => {
                    const col = document.createElement('div');
                    col.className = 'col-6 col-sm-4 col-md-3 col-lg-2';
                    const objUrl = URL.createObjectURL(file);

                    col.innerHTML = `
                        <div class="card h-100 shadow-sm border preview-card" id="previewCard_${index}">
                            <img src="${objUrl}" class="card-img-top" style="height:110px;object-fit:contain;background:#fdfdfd;padding:4px;" />
                            <div class="card-body p-2 text-center">
                                <span class="d-block text-truncate small fw-semibold" title="${file.name}">${file.name}</span>
                                <div class="form-check mt-1 d-flex align-items-center justify-content-center gap-1">
                                    <input class="form-check-input bg-radio" type="radio" name="bgImageIndex" id="bg_${index}" value="${index}">
                                    <label class="form-check-label small" for="bg_${index}" style="font-size:0.75rem;cursor:pointer;">
                                        Set as BG
                                    </label>
                                </div>
                            </div>
                        </div>
                    `;
                    previewContainer.appendChild(col);
                });

                // Radio change event to highlight selected card
                document.querySelectorAll('.bg-radio').forEach(r => {
                    r.addEventListener('change', function () {
                        document.querySelectorAll('.preview-card').forEach(c => {
                            c.style.borderColor = '';
                            c.classList.remove('shadow');
                        });
                        if (parseInt(this.value, 10) >= 0) {
                            const activeCard = document.getElementById(`previewCard_${this.value}`);
                            if (activeCard) {
                                activeCard.style.borderColor = 'var(--gold)';
                                activeCard.classList.add('shadow');
                            }
                        }
                    });
                });
            });
        }
    </script>
}

