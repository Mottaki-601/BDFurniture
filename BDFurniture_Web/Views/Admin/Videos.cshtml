@model List<BDFurniture_Web.Models.YouTubeVideo>
@{
    ViewData["Title"] = "YouTube Videos & Reels - BD Furniture Admin";
}

<div class="page-hero" style="padding-top:6rem;padding-bottom:2rem;">
    <div class="container">
        <h1><i class="fab fa-youtube me-2" style="color:#e74c3c;"></i> Manage YouTube Reels &amp; Videos</h1>
        <p style="color:rgba(255,255,255,0.75);">Add video IDs to display on the homepage horizontal scroll showcase.</p>
    </div>
</div>

<section class="section-pad">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Add Video Form -->
        <div class="admin-card mb-4">
            <h4 class="mb-3"><i class="fas fa-plus-circle text-gold me-2"></i> Add New Video / Reel</h4>
            <form asp-action="AddVideo" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label class="form-label-bd">Video Title *</label>
                        <input type="text" name="Title" class="form-control-bd" placeholder="e.g. Modern Teak Wood Sofa Crafting" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label-bd">YouTube Video ID *</label>
                        <input type="text" name="YouTubeId" class="form-control-bd" placeholder="e.g. dQw4w9WgXcQ (From URL v=...)" required />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label-bd">Sort Order</label>
                        <input type="number" name="SortOrder" class="form-control-bd" value="1" />
                    </div>
                    <div class="col-12">
                        <label class="form-label-bd">Short Description</label>
                        <input type="text" name="Description" class="form-control-bd" placeholder="Brief note about what this video shows" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn-gold"><i class="fas fa-plus"></i> Add Video to Homepage</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Video List -->
        <div class="admin-card">
            <h4 class="mb-3">Active Videos</h4>
            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var v in Model)
                    {
                        var thumb = string.IsNullOrEmpty(v.ThumbnailUrl)
                            ? $"https://img.youtube.com/vi/{v.YouTubeId}/hqdefault.jpg"
                            : v.ThumbnailUrl;
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="position-relative">
                                    <img src="@thumb" class="card-img-top" style="aspect-ratio:16/9;object-fit:cover;" />
                                    <a href="https://youtube.com/watch?v=@v.YouTubeId" target="_blank" class="position-absolute top-50 start-50 translate-middle text-white fs-1">
                                        <i class="fab fa-youtube text-danger"></i>
                                    </a>
                                </div>
                                <div class="card-body p-3">
                                    <h6 class="card-title fw-bold mb-1">@v.Title</h6>
                                    <small class="text-muted d-block mb-2">ID: @v.YouTubeId | Order: @v.SortOrder</small>
                                    <form asp-action="DeleteVideo" asp-route-id="@v.Id" method="post" onsubmit="return confirm('Remove this video?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="fas fa-trash"></i> Remove</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No videos configured yet. Add your first YouTube video above!</p>
            }
        </div>
    </div>
</section>

